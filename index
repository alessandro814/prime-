function today(){return new Date().toISOString().split('T')[0];}
function loadState(){try{return JSON.parse(localStorage.getItem('prime_state')||'{}');}catch(e){return{};}}
function saveState(s){localStorage.setItem('prime_state',JSON.stringify(s));}
function getState(){
  let s=loadState();const d=today();
  if(!s.date||s.date!==d){s.date=d;s.meals={};s.water=0;s.habits={};s.supps={};s.sets={};saveState(s);}
  if(!s.weights)s.weights=[];if(!s.prs)s.prs=PRS_DEFAULT.map(p=>({...p}));
  if(!s.streak)s.streak={count:0,last:''};if(!s.startDate)s.startDate=d;return s;
}

function showPage(name){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  document.getElementById('nav-'+name).classList.add('active');
  if(name==='track')renderChart();
}
