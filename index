    const isDone=s.sets&&s.sets[wIdx+'_'+i]&&s.sets[wIdx+'_'+i].done;
    div.innerHTML='<div class="ex-check '+(isDone?'done':'')+'" onclick="toggleExQuick('+wIdx+','+i+',this)"></div><div class="ex-name">'+ex.name+'</div><div class="ex-sets">'+ex.sets+'x'+ex.reps+'</div>';
    exCont.appendChild(div);
