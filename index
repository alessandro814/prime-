    const setData=s.sets[key];let setRowsHTML='';
    setData.rows.forEach((row,si)=>{
      setRowsHTML+='<div class="set-row"><div class="set-num">'+(si+1)+'</div><input class="input set-inp" type="number" placeholder="kg" value="'+row.kg+'" inputmode="decimal" oninput="updateSet('+activeDay+','+i+','+si+',\'kg\',this.value)"><input class="input set-inp" type="text" placeholder="reps" value="'+row.reps+'" oninput="updateSet('+activeDay+','+i+','+si+',\'reps\',this.value)"><button class="set-done-btn '+(row.done?'done':'')+'" onclick="toggleSetDone('+activeDay+','+i+','+si+',this)">'+(row.done?'✓':'○')+'</button></div>';
    });
    const card=document.createElement('div');card.className='exercise-card';
    card.innerHTML='<div class="exercise-header" onclick="toggleEx(this)"><div class="ex-num">'+String(i+1).padStart(2,'0')+'</div><div class="ex-info"><div class="ex-title">'+ex.name+'</div><div class="ex-meta">'+ex.sets+' series x '+ex.reps+' · Descanso: '+ex.rest+'</div></div><div class="ex-expand">▾</div></div><div class="exercise-body"><div class="ex-note">💡 '+ex.note+'</div><div class="sets-tracker">'+setRowsHTML+'</div><div class="rest-timer" style="margin-top:12px;"><span class="rest-label">Descanso</span><span class="rest-val" id="rest-'+activeDay+'-'+i+'">0:00</span><button class="start-rest-btn" onclick="startRest('+activeDay+','+i+',\''+ex.rest+'\')">Iniciar</button></div></div>';
    list.appendChild(card);
  });
}
function toggleEx(header){const body=header.nextElementSibling;const arrow=header.querySelector('.ex-expand');const isOpen=body.classList.toggle('open');arrow.textContent=isOpen?'▴':'▾';}
function updateSet(day,ex,set,field,val){const s=getState();if(!s.sets)s.sets={};const key=day+'_'+ex;if(!s.sets[key])return;s.sets[key].rows[set][field]=val;saveState(s);}
function toggleSetDone(day,ex,set,btn){const s=getState();if(!s.sets)s.sets={};const key=day+'_'+ex;if(!s.sets[key])return;s.sets[key].rows[set].done=!s.sets[key].rows[set].done;const done=s.sets[key].rows[set].done;btn.classList.toggle('done',done);btn.textContent=done?'✓':'○';saveState(s);toast(done?'✓ Set completado':'Set desmarcado');}
const restTimers={};
function startRest(day,ex,restStr){const key=day+'-'+ex;if(restTimers[key])clearInterval(restTimers[key]);const secs=restStr.includes('min')?parseInt(restStr)*60:parseInt(restStr);let remaining=secs||90;const el=document.getElementById('rest-'+day+'-'+ex);restTimers[key]=setInterval(()=>{remaining--;if(el)el.textContent=Math.floor(remaining/60)+':'+(remaining%60).toString().padStart(2,'0');if(remaining<=0){clearInterval(restTimers[key]);if(el)el.textContent='✓ Listo';if('vibrate'in navigator)navigator.vibrate([300,100,300]);toast('Siguiente serie!');}},1000);toast('Timer: '+(secs||90)+'s');}

function renderNutrition(){
  const s=getState();let kcalDone=0;MEALS.forEach((m,i)=>{if(s.meals[i])kcalDone+=m.kcal;});
  const macros=[{name:'Kcal',val:kcalDone,goal:2800,color:'#c8ff00'},{name:'Prot',val:Math.round(kcalDone*.25/4),goal:155,unit:'g',color:'#00e5ff'},{name:'Carbs',val:Math.round(kcalDone*.45/4),goal:320,unit:'g',color:'#ff8c00'},{name:'Grasa',val:Math.round(kcalDone*.3/9),goal:75,unit:'g',color:'#ff4455'}];
  document.getElementById('macro-rings').innerHTML=macros.map(m=>{const r=28,circ=2*Math.PI*r,pct=Math.min(m.val/m.goal,1),dash=circ*pct;return'<div class="macro-ring"><svg width="72" height="72" class="ring-svg"><circle class="ring-bg" cx="36" cy="36" r="'+r+'" stroke-width="5"/><circle class="ring-prog" cx="36" cy="36" r="'+r+'" stroke-width="5" stroke="'+m.color+'" stroke-dasharray="'+dash+' '+(circ-dash)+'" stroke-dashoffset="0"/><text x="36" y="33" style="transform:rotate(90deg);transform-origin:36px 36px;fill:'+m.color+';font-size:13px;font-family:sans-serif;text-anchor:middle;">'+m.val+'</text><text x="36" y="46" style="transform:rotate(90deg);transform-origin:36px 36px;fill:#666680;font-size:8px;text-anchor:middle;">'+(m.unit||'kcal')+'</text></svg><div class="ring-name">'+m.name+'</div></div>';}).join('');
  const water=s.water||0;document.getElementById('water-display').textContent=water.toFixed(1);document.getElementById('water-bar').style.width=Math.min(water/3*100,100)+'%';
  const ml=document.getElementById('meals-list');ml.innerHTML='';
  MEALS.forEach((m,i)=>{const done=!!s.meals[i];const card=document.createElement('div');card.className='meal-card';card.innerHTML='<div class="meal-header"><div><div class="meal-name">'+m.name+'</div><div class="meal-time">'+m.time+'</div></div><div class="meal-done-check '+(done?'done':'')+'" onclick="toggleMeal('+i+',this)"></div></div><div class="meal-foods">'+m.foods.map(f=>'<div class="food-item">'+f+'</div>').join('')+'</div><div class="meal-kcal">~'+m.kcal+' kcal</div>';ml.appendChild(card);});
}
function toggleMeal(i,el){const s=getState();if(!s.meals)s.meals={};s.meals[i]=!s.meals[i];el.classList.toggle('done',s.meals[i]);saveState(s);renderHome();renderNutrition();toast(s.meals[i]?'Comida registrada':'Desmarcado');}
function addWater(amount){const s=getState();s.water=Math.max(0,Math.round(((s.water||0)+amount)*10)/10);saveState(s);renderNutrition();renderHome();if(s.water>=3)toast('Meta de agua cumplida!');else toast(s.water.toFixed(1)+' L de 3.0 L');}
function resetWater(){const s=getState();s.water=0;saveState(s);renderNutrition();renderHome();}

function addWeight(){
  const val=parseFloat(document.getElementById('weight-inp').value);const date=document.getElementById('weight-date').value||today();
  if(!val||val<30||val>200){toast('Ingresa un peso valido');return;}
  const s=getState();if(!s.weights)s.weights=[];s.weights=s.weights.filter(w=>w.date!==date);s.weights.push({date,val});s.weights.sort((a,b)=>a.date.localeCompare(b.date));if(s.weights.length>90)s.weights=s.weights.slice(-90);
  saveState(s);document.getElementById('weight-inp').value='';renderTracking();toast('Peso guardado: '+val+' kg');
}
function renderTracking(){
  const s=getState();const hist=document.getElementById('weight-history');hist.innerHTML='';
  const ws=[...(s.weights||[])].reverse().slice(0,15);
  if(!ws.length){hist.innerHTML='<div style="color:var(--grey);font-size:13px;padding:16px 0;">Sin registros. Agrega tu primer peso.</div>';}
  ws.forEach((w,i)=>{const prev=ws[i+1];let delta='',cls='neu';if(prev){const d=(w.val-prev.val);delta=(d>0?'+':'')+d.toFixed(1)+' kg';cls=d>0?'pos':d<0?'neg':'neu';}const dateObj=new Date(w.date+'T12:00:00');const dateStr=dateObj.toLocaleDateString('es',{day:'2-digit',month:'short'});hist.innerHTML+='<div class="weight-entry"><div class="we-date">'+dateStr+'</div><div class="we-val">'+w.val+' <span style="font-size:13px;color:var(--grey);">kg</span></div>'+(delta?'<div class="we-delta '+cls+'">'+delta+'</div>':'<div></div>')+'</div>';});
  const prl=document.getElementById('pr-list');prl.innerHTML='';(s.prs||PRS_DEFAULT).forEach(pr=>{prl.innerHTML+='<div class="pr-item"><div class="pr-icon">'+pr.emoji+'</div><div class="pr-info"><div class="pr-name">'+pr.name+'</div><div class="pr-val">Record personal</div></div><div class="pr-best">'+(pr.val>0?pr.val+' '+pr.unit:'—')+'</div></div>';});
  const sel=document.getElementById('pr-select');sel.innerHTML=(s.prs||PRS_DEFAULT).map((pr,i)=>'<option value="'+i+'">'+pr.emoji+' '+pr.name+'</option>').join('');
  document.getElementById('weight-date').value=today();renderChart();
}
function savePR(){const idx=parseInt(document.getElementById('pr-select').value);const val=parseFloat(document.getElementById('pr-inp').value);const unit=document.getElementById('pr-unit-sel').value;if(!val||val<=0){toast('Ingresa un valor valido');return;}const s=getState();if(!s.prs)s.prs=PRS_DEFAULT.map(p=>({...p}));s.prs[idx].val=val;s.prs[idx].unit=unit;saveState(s);document.getElementById('pr-inp').value='';renderTracking();toast('PR guardado: '+val+' '+unit);}
function renderChart(){
  const s=getState();const ws=s.weights||[];const canvas=document.getElementById('weight-chart');if(!canvas)return;
  const dpr=window.devicePixelRatio||1;const W=canvas.parentElement.clientWidth||300;const H=140;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.width=W+'px';canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);ctx.fillStyle='#16161f';ctx.fillRect(0,0,W,H);
  if(ws.length<2){ctx.fillStyle='#666680';ctx.font='13px sans-serif';ctx.textAlign='center';ctx.fillText('Agrega 2+ registros para ver la grafica',W/2,H/2);return;}
  const vals=ws.map(w=>w.val);const minV=Math.min(...vals)-1;const maxV=Math.max(...vals)+1;const pad={t:16,r:16,b:24,l:36};const cW=W-pad.l-pad.r;const cH=H-pad.t-pad.b;
  const x=i=>pad.l+(i/(ws.length-1))*cW;const y=v=>pad.t+(1-(v-minV)/(maxV-minV))*cH;
  ctx.strokeStyle='#2a2a3a';ctx.lineWidth=1;[0,.25,.5,.75,1].forEach(t=>{const yy=pad.t+t*cH;ctx.beginPath();ctx.moveTo(pad.l,yy);ctx.lineTo(W-pad.r,yy);ctx.stroke();ctx.fillStyle='#666680';ctx.font='9px monospace';ctx.textAlign='right';ctx.fillText((maxV-t*(maxV-minV)).toFixed(1),pad.l-4,yy+3);});
  const grad=ctx.createLinearGradient(0,pad.t,0,pad.t+cH);grad.addColorStop(0,'rgba(200,255,0,0.25)');grad.addColorStop(1,'rgba(200,255,0,0)');ctx.beginPath();ctx.moveTo(x(0),y(vals[0]));ws.forEach((_,i)=>{if(i>0)ctx.lineTo(x(i),y(vals[i]));});ctx.lineTo(x(ws.length-1),pad.t+cH);ctx.lineTo(x(0),pad.t+cH);ctx.closePath();ctx.fillStyle=grad;ctx.fill();
  ctx.beginPath();ctx.strokeStyle='#c8ff00';ctx.lineWidth=2;ctx.lineJoin='round';ctx.lineCap='round';ws.forEach((_,i)=>{if(i===0)ctx.moveTo(x(i),y(vals[i]));else ctx.lineTo(x(i),y(vals[i]));});ctx.stroke();
  ws.forEach((_,i)=>{ctx.beginPath();ctx.arc(x(i),y(vals[i]),3.5,0,Math.PI*2);ctx.fillStyle='#c8ff00';ctx.fill();ctx.strokeStyle='#0a0a0a';ctx.lineWidth=1.5;ctx.stroke();});
  const lx=x(ws.length-1),ly=y(vals[vals.length-1]);ctx.fillStyle='#c8ff00';ctx.font='bold 11px monospace';ctx.textAlign='right';ctx.fillText(vals[vals.length-1]+'kg',lx+2,ly-8);
}

function renderHabits(){
  const s=getState();const cont=document.getElementById('habits-container');cont.innerHTML='';
  let total=0,done=0;HABITS.forEach(cat=>cat.items.forEach(h=>{total++;if(s.habits[h.name])done++;}));
  document.getElementById('habit-count-label').textContent=done+' / '+total;
  document.getElementById('habit-main-prog').style.width=(total?done/total*100:0)+'%';
  HABITS.forEach(cat=>{
    const section=document.createElement('div');section.className='habit-section';
    section.innerHTML='<div class="section-label" style="margin-top:8px;">'+cat.cat+'</div>';
    cat.items.forEach(h=>{const isDone=!!s.habits[h.name];const row=document.createElement('div');row.className='habit-row';row.innerHTML='<div class="habit-circle '+(isDone?'done':'')+'"></div><div class="habit-text"><div class="habit-name" style="'+(isDone?'color:var(--grey);text-decoration:line-through;':'')+'">'+h.name+'</div><div class="habit-benefit">'+h.benefit+'</div></div>';row.onclick=()=>toggleHabit(h.name);section.appendChild(row);});
    cont.appendChild(section);
  });
}
function toggleHabit(name){const s=getState();if(!s.habits)s.habits={};s.habits[name]=!s.habits[name];updateStreak(s);saveState(s);renderHabits();renderHome();toast(s.habits[name]?'Habito completado':'Desmarcado');}

function renderSupps(){
  const s=getState();const list=document.getElementById('supp-list');list.innerHTML='';
  SUPPLEMENTS.forEach((sup,i)=>{const taken=!!s.supps[i];const isDisabled=sup.when==='none';const card=document.createElement('div');card.className='supp-card';card.innerHTML='<div class="supp-header"><div class="supp-name" style="color:'+sup.color+'">'+sup.name+'</div><div class="badge" style="background:rgba(255,255,255,.06);color:var(--grey);font-size:10px;">'+sup.priority+'</div></div><div class="supp-dose" style="color:'+sup.color+';opacity:.7;margin-bottom:8px;">'+sup.dose+'</div><div class="supp-desc">'+sup.desc+'</div>'+(isDisabled?'<div style="padding:10px 0;font-size:12px;color:var(--red);font-weight:700;">No recomendado - Espera a los 21+</div>':'<button class="supp-taken-btn '+(taken?'taken':'')+'" onclick="toggleSupp('+i+',this)">'+(taken?'Tomado hoy':'Marcar como tomado')+'</button>');list.appendChild(card);});
}
function toggleSupp(i,btn){const s=getState();if(!s.supps)s.supps={};s.supps[i]=!s.supps[i];btn.classList.toggle('taken',s.supps[i]);btn.textContent=s.supps[i]?'Tomado hoy':'Marcar como tomado';saveState(s);toast(s.supps[i]?'Suplemento registrado':'Desmarcado');}

let toastTimeout;
function toast(msg){const el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>el.classList.remove('show'),2200);}

if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});

function init(){renderHome();renderWorkout();renderNutrition();renderTracking();renderHabits();renderSupps();}
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(init);else window.addEventListener('load',init);
</script>
</body>
