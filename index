function renderHome(){
  const s=getState();const hour=new Date().getHours();
  document.getElementById('greeting').textContent=hour<12?'Buenos dias ☀️':hour<18?'Buenas tardes ⚡':'Buenas noches 🌙';
  const start=new Date(s.startDate||today());
  document.getElementById('week-num').textContent=Math.floor((new Date()-start)/(7*24*3600*1000))+1;
  document.getElementById('streak-home').textContent=s.streak.count||0;
  if(s.weights&&s.weights.length)document.getElementById('stat-weight').textContent=s.weights[s.weights.length-1].val;
  document.getElementById('stat-water').textContent=(s.water||0).toFixed(1);
  let kcalDone=0;MEALS.forEach((m,i)=>{if(s.meals[i])kcalDone+=m.kcal;});
  document.getElementById('stat-kcal').textContent=kcalDone;
  let totalH=0,doneH=0;HABITS.forEach(cat=>cat.items.forEach(h=>{totalH++;if(s.habits[h.name])doneH++;}));
  document.getElementById('habits-today-fraction').innerHTML=doneH+'<span style="color:var(--grey);font-size:16px;">/'+totalH+'</span>';
  document.getElementById('habits-prog-bar').style.width=(totalH?doneH/totalH*100:0)+'%';
  const dayIdx=new Date().getDay();const wIdx=dayIdx===0?6:dayIdx-1;const w=WORKOUTS[wIdx];
  document.getElementById('today-badge').textContent=w.label;
