function toggleExQuick(wIdx,exIdx,el){
  const s=getState();if(!s.sets)s.sets={};const key=wIdx+'_'+exIdx;
  if(!s.sets[key])s.sets[key]={};s.sets[key].done=!s.sets[key].done;
  el.classList.toggle('done',s.sets[key].done);updateStreak(s);saveState(s);
}
function updateStreak(s){
  let doneH=0,totalH=0;HABITS.forEach(cat=>cat.items.forEach(h=>{totalH++;if(s.habits[h.name])doneH++;}));
  if(doneH>=Math.floor(totalH*0.7)){const t=today();if(s.streak.last!==t){const y=new Date();y.setDate(y.getDate()-1);const yStr=y.toISOString().split('T')[0];if(s.streak.last===yStr)s.streak.count++;else s.streak.count=1;s.streak.last=t;}}
}

