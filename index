<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="PRIME">
<meta name="theme-color" content="#0a0a0a">
<title>PRIME</title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

<style>
:root {
  --lime: #c8ff00;
  --cyan: #00e5ff;
  --bg: #0a0a0a;
  --bg2: #111118;
  --card: #16161f;
  --card2: #1e1e2a;
  --border: #2a2a3a;
  --white: #f0f0f0;
  --grey: #666680;
  --red: #ff4455;
  --orange: #ff8c00;
  --green: #00ff88;
  --yellow: #ffd700;
  --radius: 16px;
  --radius-sm: 10px;
  --font-display: 'Bebas Neue', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --nav-h: 68px;
  --safe-b: env(safe-area-inset-bottom, 0px);
}

* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html,body { height:100%; overflow:hidden; background:var(--bg); color:var(--white); font-family:var(--font-body); }

.page { position:absolute; inset:0; bottom:calc(var(--nav-h) + var(--safe-b)); overflow-y:auto; overflow-x:hidden; display:none; padding:0 0 24px; }
.page.active { display:block; }
.page::-webkit-scrollbar { display:none; }

.nav { position:fixed; bottom:0; left:0; right:0; height:calc(var(--nav-h) + var(--safe-b)); background:rgba(10,10,10,0.96); backdrop-filter:blur(20px); border-top:1px solid var(--border); display:flex; z-index:100; padding-bottom:var(--safe-b); }
.nav-btn { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; cursor:pointer; transition:all .2s; border:none; background:none; color:var(--grey); padding:8px 0; }
.nav-btn.active { color:var(--lime); }
.nav-btn svg { width:22px; height:22px; }
.nav-btn span { font-size:9px; font-weight:600; letter-spacing:.5px; text-transform:uppercase; font-family:var(--font-body); }
.nav-dot { width:4px; height:4px; background:var(--lime); border-radius:50%; margin-top:2px; opacity:0; transition:.2s; }
.nav-btn.active .nav-dot { opacity:1; }

.page-header { padding:20px 20px 0; }
.page-title { font-family:var(--font-display); font-size:42px; letter-spacing:1px; line-height:1; color:var(--lime); }
.page-sub { font-size:13px; color:var(--grey); margin-top:4px; font-weight:400; }

.card { background:var(--card); border-radius:var(--radius); padding:18px; border:1px solid var(--border); }
.card-sm { background:var(--card); border-radius:var(--radius-sm); padding:14px; border:1px solid var(--border); }
.section-label { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--grey); margin-bottom:10px; }

.btn { display:flex; align-items:center; justify-content:center; gap:8px; padding:14px 20px; border-radius:var(--radius-sm); font-size:14px; font-weight:600; border:none; cursor:pointer; transition:all .15s; font-family:var(--font-body); }
.btn-lime { background:var(--lime); color:#000; }
.btn-lime:active { transform:scale(.97); background:#b0e000; }
.btn-outline { background:transparent; border:1.5px solid var(--border); color:var(--white); }
.btn-outline:active { background:var(--card2); }

.input { background:var(--card2); border:1.5px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; color:var(--white); font-size:15px; font-family:var(--font-body); width:100%; outline:none; -webkit-appearance:none; }
.input:focus { border-color:var(--lime); }
select.input option { background:var(--card2); }

.badge { display:inline-block; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; }
.badge-lime { background:rgba(200,255,0,.15); color:var(--lime); }
.badge-cyan { background:rgba(0,229,255,.15); color:var(--cyan); }
.badge-red  { background:rgba(255,68,85,.15);  color:var(--red); }
.badge-green{ background:rgba(0,255,136,.15);  color:var(--green); }

.prog-bar { height:6px; background:var(--card2); border-radius:10px; overflow:hidden; }
.prog-fill { height:100%; background:linear-gradient(90deg,var(--lime),var(--cyan)); border-radius:10px; transition:width .5s ease; }

.home-hero { margin:20px; background:linear-gradient(135deg,var(--card) 0%,var(--card2) 100%); border-radius:var(--radius); padding:22px; border:1px solid var(--border); position:relative; overflow:hidden; }
.home-hero::before { content:''; position:absolute; top:-30px; right:-30px; width:120px; height:120px; background:radial-gradient(circle,rgba(200,255,0,.15),transparent 70%); border-radius:50%; }
.hero-greeting { font-size:13px; color:var(--grey); font-weight:500; }
.hero-name { font-family:var(--font-display); font-size:36px; color:var(--white); letter-spacing:1px; }
.hero-name span { color:var(--lime); }
.streak-num { font-family:var(--font-display); font-size:28px; color:var(--lime); }
.streak-label { font-size:12px; color:var(--grey); line-height:1.3; }

.stats-row { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin:0 20px; }
.stat-card { background:var(--card); border-radius:var(--radius-sm); padding:14px 12px; border:1px solid var(--border); text-align:center; }
.stat-val { font-family:var(--font-display); font-size:26px; color:var(--white); }
.stat-unit { font-size:10px; color:var(--lime); font-weight:700; }
.stat-lbl { font-size:10px; color:var(--grey); margin-top:2px; }

.today-card { margin:0 20px; background:var(--card); border-radius:var(--radius); padding:18px; border:1px solid var(--border); }
.today-workout-name { font-family:var(--font-display); font-size:22px; color:var(--lime); }
.today-exercises { margin-top:12px; display:flex; flex-direction:column; gap:8px; }
.ex-row { display:flex; align-items:center; gap:12px; }
.ex-check { width:22px; height:22px; border-radius:6px; border:1.5px solid var(--border); background:transparent; cursor:pointer; flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:.2s; }
.ex-check.done { background:var(--lime); border-color:var(--lime); }
.ex-check.done::after { content:'✓'; font-size:13px; color:#000; font-weight:800; }
.ex-name { font-size:13px; color:var(--white); flex:1; }
.ex-sets { font-size:11px; color:var(--grey); }

.reminders-card { margin:0 20px; }
.reminder-item { display:flex; align-items:center; gap:12px; padding:12px 16px; background:var(--card); border-radius:var(--radius-sm); border:1px solid var(--border); margin-bottom:8px; }
.reminder-icon { font-size:20px; }
.reminder-text { flex:1; }
.reminder-title { font-size:13px; font-weight:600; color:var(--white); }
.reminder-time { font-size:11px; color:var(--grey); }

.day-tabs { display:flex; gap:8px; padding:16px 20px 0; overflow-x:auto; scrollbar-width:none; }
.day-tabs::-webkit-scrollbar { display:none; }
.day-tab { flex-shrink:0; padding:8px 16px; border-radius:20px; font-size:12px; font-weight:700; border:1.5px solid var(--border); background:transparent; color:var(--grey); cursor:pointer; transition:.2s; font-family:var(--font-body); }
.day-tab.active { background:var(--lime); border-color:var(--lime); color:#000; }

.workout-header { padding:16px 20px 12px; }
.workout-title { font-family:var(--font-display); font-size:32px; color:var(--white); }
.workout-focus { font-size:13px; color:var(--cyan); margin-top:2px; }

.exercise-list { padding:0 20px; display:flex; flex-direction:column; gap:12px; }
.exercise-card { background:var(--card); border-radius:var(--radius); border:1px solid var(--border); overflow:hidden; }
.exercise-header { padding:14px 16px; display:flex; align-items:center; gap:12px; cursor:pointer; }
.ex-num { width:30px; height:30px; background:rgba(200,255,0,.1); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; color:var(--lime); font-family:var(--font-mono); flex-shrink:0; }
.ex-info { flex:1; }
.ex-title { font-size:14px; font-weight:600; color:var(--white); }
.ex-meta { font-size:11px; color:var(--grey); margin-top:2px; }
.ex-expand { color:var(--grey); transition:.2s; }
.exercise-body { display:none; padding:0 16px 16px; border-top:1px solid var(--border); }
.exercise-body.open { display:block; }
.ex-note { font-size:12px; color:var(--cyan); margin-bottom:12px; padding-top:12px; font-style:italic; }
.set-inp { background:var(--card2); border:1.5px solid var(--border); border-radius:8px; padding:10px 12px; color:var(--white); font-size:14px; font-family:var(--font-mono); width:100%; text-align:center; outline:none; }
.set-inp:focus { border-color:var(--lime); }
.sets-tracker { display:flex; flex-direction:column; gap:6px; }
.set-row { display:grid; grid-template-columns:30px 1fr 1fr 40px; gap:8px; align-items:center; }
.set-num { font-size:11px; color:var(--grey); text-align:center; font-family:var(--font-mono); }
.set-done-btn { width:32px; height:32px; border-radius:8px; border:1.5px solid var(--border); background:transparent; color:var(--grey); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:14px; transition:.2s; }
.set-done-btn.done { background:var(--lime); border-color:var(--lime); color:#000; }
.rest-timer { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--card2); border-radius:8px; margin-top:8px; }
.rest-label { font-size:12px; color:var(--grey); }
.rest-val { font-family:var(--font-display); font-size:20px; color:var(--lime); }
.start-rest-btn { padding:6px 14px; background:var(--lime); border:none; border-radius:6px; font-size:12px; font-weight:700; color:#000; cursor:pointer; font-family:var(--font-body); }

.macro-ring-row { display:flex; justify-content:space-around; align-items:center; padding:20px 20px 0; }
.macro-ring { text-align:center; }
.ring-svg { transform:rotate(-90deg); }
.ring-bg { fill:none; stroke:var(--card2); }
.ring-prog { fill:none; stroke-linecap:round; transition:stroke-dashoffset .5s ease; }
.ring-name { font-size:11px; color:var(--grey); margin-top:4px; font-weight:600; }

.meals-list { padding:0 20px; display:flex; flex-direction:column; gap:10px; }
.meal-card { background:var(--card); border-radius:var(--radius); border:1px solid var(--border); padding:16px; }
.meal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
.meal-name { font-size:15px; font-weight:700; color:var(--white); }
.meal-time { font-size:11px; color:var(--grey); }
.meal-done-check { width:26px; height:26px; border-radius:50%; border:2px solid var(--border); background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:.2s; }
.meal-done-check.done { background:var(--lime); border-color:var(--lime); }
.meal-done-check.done::after { content:'✓'; font-size:13px; color:#000; font-weight:800; }
.meal-foods { display:flex; flex-direction:column; gap:4px; }
.food-item { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--grey); }
.food-item::before { content:''; width:4px; height:4px; background:var(--border); border-radius:50%; flex-shrink:0; }
.meal-kcal { font-size:12px; color:var(--lime); font-weight:600; margin-top:10px; }

.water-card { margin:0 20px; background:var(--card); border-radius:var(--radius); border:1px solid var(--border); padding:18px; }
.water-display { display:flex; align-items:baseline; gap:6px; margin:8px 0; }
.water-val { font-family:var(--font-display); font-size:40px; color:var(--cyan); }
.water-goal { font-size:14px; color:var(--grey); }
.water-btns { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:12px; }
.water-btn { padding:12px; border-radius:8px; border:1.5px solid var(--border); background:transparent; color:var(--cyan); font-size:13px; font-weight:600; cursor:pointer; font-family:var(--font-body); transition:.2s; }
.water-btn:active { background:rgba(0,229,255,.1); }

.add-weight-form { background:var(--card); border-radius:var(--radius); border:1px solid var(--border); padding:18px; }
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px; }
.chart-card { margin:0 20px; background:var(--card); border-radius:var(--radius); border:1px solid var(--border); padding:18px; }
.chart-wrap { width:100%; overflow-x:auto; }
.chart-canvas { display:block; }
.weight-history { padding:0 20px; }
.weight-entry { display:flex; align-items:center; justify-content:space-between; padding:12px 0; border-bottom:1px solid var(--border); }
.we-date { font-size:12px; color:var(--grey); }
.we-val { font-family:var(--font-display); font-size:20px; color:var(--white); }
.we-delta { font-size:12px; font-weight:600; }
.we-delta.pos { color:var(--green); }
.we-delta.neg { color:var(--red); }
.we-delta.neu { color:var(--grey); }
.pr-list { padding:0 20px; display:flex; flex-direction:column; gap:8px; }
.pr-item { background:var(--card); border-radius:var(--radius-sm); border:1px solid var(--border); padding:14px 16px; display:flex; align-items:center; gap:12px; }
.pr-icon { font-size:20px; }
.pr-info { flex:1; }
.pr-name { font-size:13px; font-weight:600; color:var(--white); }
.pr-val { font-size:12px; color:var(--grey); margin-top:1px; }
.pr-best { font-family:var(--font-display); font-size:22px; color:var(--lime); }

.habit-section { padding:0 20px; }
.habit-row { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid rgba(42,42,58,.6); cursor:pointer; }
.habit-circle { width:28px; height:28px; border-radius:50%; border:2px solid var(--border); flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:.2s; }
.habit-circle.done { background:var(--lime); border-color:var(--lime); }
.habit-circle.done::after { content:'✓'; font-size:12px; color:#000; font-weight:800; }
.habit-text { flex:1; }
.habit-name { font-size:13px; color:var(--white); }
.habit-benefit { font-size:11px; color:var(--grey); margin-top:1px; }
.habit-progress-bar { margin:0 20px 16px; }
.hpb-label { display:flex; justify-content:space-between; margin-bottom:8px; }
.hpb-text { font-size:13px; color:var(--white); font-weight:600; }
.hpb-val { font-size:13px; color:var(--lime); font-weight:700; font-family:var(--font-mono); }

.supp-list { padding:0 20px; display:flex; flex-direction:column; gap:10px; }
.supp-card { background:var(--card); border-radius:var(--radius); border:1px solid var(--border); padding:16px; }
.supp-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
.supp-name { font-size:15px; font-weight:700; }
.supp-dose { font-size:12px; color:var(--grey); }
.supp-desc { font-size:12px; color:var(--grey); line-height:1.5; margin-bottom:12px; }
.supp-taken-btn { width:100%; padding:11px; border-radius:8px; border:1.5px solid var(--lime); background:transparent; color:var(--lime); font-size:13px; font-weight:700; cursor:pointer; transition:.2s; font-family:var(--font-body); }
.supp-taken-btn.taken { background:var(--lime); color:#000; }

.toast { position:fixed; bottom:calc(var(--nav-h) + var(--safe-b) + 12px); left:50%; transform:translateX(-50%) translateY(20px); background:var(--card2); border:1px solid var(--lime); color:var(--lime); padding:10px 20px; border-radius:30px; font-size:13px; font-weight:600; white-space:nowrap; z-index:300; opacity:0; transition:.3s; pointer-events:none; }
.toast.show { opacity:1; transform:translateX(-50%) translateY(0); }

.w-full { width:100%; }
.mt-12 { margin-top:12px; }
.px-20 { padding:0 20px; }
</style>
</head>
<body>

<div class="page active" id="page-home">
  <div class="page-header" style="padding-bottom:16px;">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div class="hero-greeting" id="greeting">Buenos días</div>
        <div class="hero-name">ALES<span>SANDRO</span></div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:10px;color:var(--grey);font-weight:600;text-transform:uppercase;letter-spacing:1px;">Semana</div>
        <div style="font-family:var(--font-display);font-size:32px;color:var(--lime);" id="week-num">1</div>
      </div>
    </div>
  </div>
  <div class="home-hero">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div style="font-size:11px;color:var(--grey);font-weight:600;text-transform:uppercase;letter-spacing:1px;">Racha actual</div>
        <div style="display:flex;align-items:baseline;gap:6px;margin-top:4px;">
          <div class="streak-num" id="streak-home">0</div>
          <div class="streak-label">días<br>consecutivos</div>
        </div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:11px;color:var(--grey);font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Hábitos hoy</div>
        <div id="habits-today-fraction" style="font-family:var(--font-display);font-size:28px;color:var(--white);">0<span style="color:var(--grey);font-size:16px;">/20</span></div>
      </div>
    </div>
    <div class="prog-bar mt-12">
      <div class="prog-fill" id="habits-prog-bar" style="width:0%"></div>
    </div>
  </div>
  <div style="height:12px;"></div>
  <div class="stats-row">
    <div class="stat-card"><div class="stat-val" id="stat-weight">68</div><div class="stat-unit">KG</div><div class="stat-lbl">Peso actual</div></div>
    <div class="stat-card"><div class="stat-val" id="stat-kcal">0</div><div class="stat-unit">KCAL</div><div class="stat-lbl">Comidas ✓</div></div>
    <div class="stat-card"><div class="stat-val" id="stat-water">0.0</div><div class="stat-unit">L</div><div class="stat-lbl">Agua hoy</div></div>
  </div>
  <div style="height:16px;"></div>
  <div class="today-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
      <div class="section-label" style="margin:0;">Hoy entrenas</div>
      <div class="badge badge-lime" id="today-badge">PUSH A</div>
    </div>
    <div class="today-workout-name" id="today-wname">Push A</div>
    <div class="today-exercises" id="today-exercises"></div>
    <button class="btn btn-lime w-full mt-12" onclick="goToWorkout()" style="font-size:13px;">Ver rutina completa →</button>
  </div>
  <div style="height:16px;"></div>
  <div style="padding:0 20px;"><div class="section-label">Recordatorios de hoy</div></div>
  <div id="reminders-home" style="padding:0 20px;display:flex;flex-direction:column;gap:8px;"></div>
  <div style="height:16px;"></div>
  <div style="margin:0 20px;padding:16px;background:linear-gradient(135deg,rgba(200,255,0,.06),rgba(0,229,255,.06));border-radius:var(--radius);border:1px solid var(--border);">
    <div style="font-size:11px;color:var(--grey);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Mentalidad del día</div>
    <div style="font-size:14px;color:var(--white);line-height:1.6;font-style:italic;" id="daily-quote"></div>
  </div>
</div>

<div class="page" id="page-workout">
  <div class="page-header"><div class="page-title">RUTINA</div><div class="page-sub">Selecciona el día y registra tus sets</div></div>
  <div class="day-tabs" id="day-tabs"></div>
  <div class="workout-header">
    <div class="workout-title" id="workout-title">PUSH A</div>
    <div class="workout-focus" id="workout-focus">Pecho Superior · Hombros · Tríceps</div>
  </div>
  <div class="exercise-list" id="exercise-list"></div>
</div>

<div class="page" id="page-nutrition">
  <div class="page-header"><div class="page-title">NUTRICIÓN</div><div class="page-sub">Sigue tu plan y macros diarios</div></div>
  <div class="macro-ring-row" id="macro-rings"></div>
  <div style="height:16px;"></div>
  <div class="water-card">
    <div class="section-label">Agua del día</div>
    <div class="water-display"><div class="water-val" id="water-display">0.0</div><div class="water-goal">/ 3.0 L</div></div>
    <div class="prog-bar"><div class="prog-fill" id="water-bar" style="width:0%;background:linear-gradient(90deg,var(--cyan),#00b4d8);"></div></div>
    <div class="water-btns">
      <button class="water-btn" onclick="addWater(0.25)">+ 250 ml</button>
      <button class="water-btn" onclick="addWater(0.5)">+ 500 ml</button>
      <button class="water-btn" onclick="addWater(-0.25)" style="color:var(--grey);">- 250 ml</button>
      <button class="water-btn" onclick="resetWater()" style="color:var(--grey);">Reiniciar</button>
    </div>
  </div>
  <div style="height:16px;"></div>
  <div style="padding:0 20px;"><div class="section-label">Plan de comidas</div></div>
  <div class="meals-list" id="meals-list"></div>
</div>

<div class="page" id="page-track">
  <div class="page-header"><div class="page-title">TRACKING</div><div class="page-sub">Registra tu progreso semanal</div></div>
